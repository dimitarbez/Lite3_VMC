<launch>
  <arg name="emotion_bot_path" default="/workspaces/emotion-bot"/>
  <arg name="backend" default="deterministic"/>
  <arg name="personality" default="balanced"/>
  <arg name="seed" default="7"/>
  <arg name="chat_backend" default="deterministic"/>
  <arg name="chat_model" default="gpt-5-mini"/>
  <arg name="uplink_port" default="8767"/>

  <group ns="emotion_bot">
    <rosparam command="load" file="$(find emotion_bot_ros)/config/default.yaml"/>
    <param name="runtime/emotion_bot_path" value="$(arg emotion_bot_path)"/>
    <param name="runtime/backend" value="$(arg backend)"/>
    <param name="runtime/personality" value="$(arg personality)"/>
    <param name="runtime/seed" value="$(arg seed)"/>
    <param name="chat/backend" value="$(arg chat_backend)"/>
    <param name="chat/model" value="$(arg chat_model)"/>

    <node pkg="emotion_bot_ros" type="chat_adapter.py" name="chat_adapter" output="screen"/>
    <node pkg="emotion_bot_ros" type="emotion_adapter.py" name="adapter" output="screen"/>
    <node pkg="emotion_bot_ros" type="hardware_uplink.py" name="hardware_uplink" output="screen">
      <param name="host" value="127.0.0.1"/>
      <param name="port" value="$(arg uplink_port)"/>
      <param name="rate" value="5.0"/>
    </node>
  </group>
</launch>
